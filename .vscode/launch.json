{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AT32 Debug (OpenOCD)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/Debug/AT32F421G8U7_WorkBench.elf",
      "gdbPath": "C:/DevEnv/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
      "serverpath": "C:/Users/xiao1/AppData/Local/at32-tools/OpenOCD/V2.0.9/bin/openocd.exe",
      "openocdPath": "C:/Users/xiao1/AppData/Local/at32-tools/OpenOCD/V2.0.9/bin/openocd.exe",
      "configFiles": [
        "openocd/interface/cmsis-dap.cfg",
        "openocd/target/at32f421xx.cfg"
      ],
      "svdFile": "${workspaceFolder}/svd/AT32F421xx_v2.svd",
      "runToEntryPoint": "main",
      "device": "AT32F421G8U7",
      "interface": "swd",
      "preLaunchTask": "build",
      "liveWatch": {
        "enabled": true,
        "interval": 100,
        "expressions": []
      },
      "showDevDebugOutput": "none"
    }
  ]
}
